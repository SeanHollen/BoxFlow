{
  "name": "boxcomponents",
  "version": "0.1.0",
  "description": "Coordinate-based declarative layout for React: position boxes with pivots, x/y coordinates, and sizes derived from the parent box.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "oxlint --type-aware src/ tests/ example/ && oxfmt --write src/ tests/ example/ && tsc --noEmit && vitest run",
    "test": "vitest run",
    "dev": "vite example",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
